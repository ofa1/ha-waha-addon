worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stdout info;
daemon off;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;
    proxy_read_timeout 1200;
    proxy_send_timeout 1200;
    client_max_body_size 50M;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Home Assistant sends the randomly generated ingress prefix in this header,
    # for example: /api/hassio_ingress/<token>
    map $http_x_ingress_path $ingress_path {
        default $http_x_ingress_path;
        '' '';
    }

    upstream waha_backend {
        server 127.0.0.1:3000;
    }

    server {
        listen 8099 default_server;
        listen [::]:8099 default_server;

        # HA Supervisor ingress gateway. Do not expose this proxy directly.
        allow 172.30.32.2;
        deny all;

        server_name _;
        absolute_redirect off;
        port_in_redirect off;
        server_name_in_redirect off;
        root /dev/null;

        proxy_http_version 1.1;
        proxy_buffering off;

        # Do not let the browser sniff a response into a different type, and do
        # not leak the random ingress token to third parties via Referer.
        # X-Frame-Options / frame-ancestors are deliberately absent: Home
        # Assistant renders the add-on panel inside an iframe.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;

        # Proxy settings are declared once here and inherited by every location
        # below, so the API and dashboard cannot drift apart on credentials.
        proxy_redirect ~^(/.*)$ $ingress_path$1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Ingress-Path $ingress_path;
        proxy_set_header X-NginX-Proxy true;
        # Credentials are injected here and never sent to the browser. These
        # also overwrite anything a client supplies under the same names.
        proxy_set_header Authorization "__WAHA_BASIC_AUTH__";
        proxy_set_header X-Api-Key "__WAHA_API_KEY__";
        proxy_set_header Accept-Encoding "";

        # The add-on panel opens ingress at `/`. WAHA serves the dashboard
        # under `/dashboard`, so redirect the ingress root there.
        location = / {
            return 302 $ingress_path/dashboard/;
        }

        # Simple no-secret browser helper for manually testing a WhatsApp Channel
        # post through the ingress proxy. The browser never sees WAHA_API_KEY;
        # nginx injects it only on proxied /api requests below.
        location = /channel-test {
            return 302 $ingress_path/channel-test/;
        }

        location = /channel-test/ {
            # Served as a real file: an inline `return 200 '...'` string would
            # blow past nginx's 4096-byte config token buffer, and nginx would
            # also try to interpolate the `$` characters inside the page JS.
            #
            # Use root + try_files rather than `alias <file>`. This URI ends in
            # `/`, so nginx treats it as a directory request and appends the
            # index to the alias value, producing the bogus concatenated path
            # `channel-test.htmlindex.html`. try_files skips index handling.
            root /usr/share/waha-ingress;
            try_files /channel-test.html =404;

            # A location with its own add_header drops the server-level ones,
            # so repeat them here. 'unsafe-inline' is required because the page
            # carries its own <style> and <script>; everything else is denied,
            # and connect-src 'self' keeps its fetches on this origin.
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "no-referrer" always;
            add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; form-action 'none'; base-uri 'none'" always;
        }

        # WAHA's API and MCP endpoints are proxied verbatim. They must NOT go
        # through the sub_filter block below: those rules rewrite any response
        # text starting with "/api or "/dashboard, which would silently corrupt
        # JSON payloads such as WhatsApp message bodies containing those
        # strings. Only the dashboard's own HTML/CSS/JS needs path rewriting.
        # Match `/api` and `/api/...` exactly. A bare `^~ /api` prefix would
        # also swallow paths like `/apidocs`, which is Swagger UI HTML and does
        # need the dashboard's path rewriting to render under ingress.
        location = /api {
            proxy_pass http://waha_backend;
        }

        location ^~ /api/ {
            proxy_pass http://waha_backend;
        }

        location ^~ /mcp {
            proxy_pass http://waha_backend;
        }

        # Static dashboard assets and any other WAHA path.
        location / {
            proxy_pass http://waha_backend;

            # WAHA's dashboard can emit absolute paths. Rewrite common HTML/CSS/JS
            # references so they remain under the HA ingress prefix.
            sub_filter_once off;
            # text/html is always included by nginx; listing it again warns.
            sub_filter_types text/css application/javascript text/javascript application/json;
            sub_filter 'href="/' 'href="$ingress_path/';
            sub_filter 'src="/' 'src="$ingress_path/';
            sub_filter 'action="/' 'action="$ingress_path/';
            sub_filter 'url(/' 'url($ingress_path/';

            # WAHA dashboard is a Nuxt app built with an absolute /dashboard
            # baseURL. Under Home Assistant ingress, JS-generated asset/API
            # URLs must also stay below the random ingress prefix.
            sub_filter '"/dashboard' '"$ingress_path/dashboard';
            sub_filter "'/dashboard" "'$ingress_path/dashboard";
            sub_filter '`/dashboard' '`$ingress_path/dashboard';
            sub_filter '"/api' '"$ingress_path/api';
            sub_filter "'/api" "'$ingress_path/api";
            sub_filter '`/api' '`$ingress_path/api';
            sub_filter 'baseURL:"/"' 'baseURL:"$ingress_path/"';
            sub_filter 'baseURL:"/dashboard/"' 'baseURL:"$ingress_path/dashboard/"';

            sub_filter 'fetch("/' 'fetch("$ingress_path/';
            sub_filter "fetch('/" "fetch('$ingress_path/";
            sub_filter 'axios.get("/' 'axios.get("$ingress_path/';
            sub_filter 'axios.post("/' 'axios.post("$ingress_path/';
            sub_filter 'axios.put("/' 'axios.put("$ingress_path/';
            sub_filter 'axios.delete("/' 'axios.delete("$ingress_path/';
        }
    }
}
